# RAG 微服务环境变量示例：复制为 .env 后按需修改（服务启动时自动读取）

# ---- MySQL（向量化前的知识文档存这里） ----
TCM_MYSQL_HOST=127.0.0.1
TCM_MYSQL_PORT=3306
TCM_MYSQL_USER=root
TCM_MYSQL_PASSWORD=123456
TCM_MYSQL_DATABASE=lora

# ---- 嵌入模型（本地 HuggingFace） ----
TCM_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TCM_EMBED_DEVICE=cpu

# ---- 检索 ----
TCM_RAG_TOP_K=3
# 滤除阈值：语义分低于该值「且」无词汇命中才丢弃
TCM_RAG_MIN_SCORE=0.20
# 混合检索：词汇路（bigram BM25）在加权 RRF 中的权重与融合常数
TCM_RAG_LEXICAL_WEIGHT=4.0
TCM_RAG_RRF_K=60
# 默认立场：aligned 最安全；消融实验时由请求参数覆盖
# aligned 同向(安全对齐) / neutral 中立(无安全拦截) / opposed 反向(恶意诱导) / all 混合
TCM_RAG_STANCE=aligned
# 对抗性立场开关：opposed 与 all 含不安全医疗建议原文，默认关闭
# ⚠️ 仅用于课程设计的对照实验，确认后再置为 1
TCM_RAG_ALLOW_OPPOSED=0

# ---- LLM（同伴 MacBook 上的 LoRA 服务；留空 = 全降级模拟） ----
# auto: 先试 webapp 接口，再试 OpenAI 兼容接口，均失败则本地降级模拟
TCM_LLM_MODE=auto
TCM_LLM_URL=http://192.168.108.82:8088
TCM_LLM_VARIANT=lora
TCM_LLM_TIMEOUT=8

# ---- 服务 ----
TCM_RAG_HOST=0.0.0.0
TCM_RAG_PORT=8090

# ---- 可选鉴权（留空 = 不鉴权，答辩演示建议留空） ----
TCM_RAG_API_KEY=
